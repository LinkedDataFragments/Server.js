{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "commonjs",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitOverride": true,
    "declaration": true,
    "inlineSources": true,
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true,
    "skipLibCheck": false
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/lib/**/*",
    "packages/*/bin/**/*",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
