{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/lib/**/*",
    "packages/*/bin/**/*",
    "packages/*/test/**/*.ts",
