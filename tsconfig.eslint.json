{
  // Only ESLint's type-aware rules use this: its parser needs every file it lints
  // to belong to a program, which the build config deliberately does not cover.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/lib/**/*",
    "packages/*/bin/**/*",
    "packages/*/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
